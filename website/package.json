{
  "name": "detectkit-website",
  "private": true,
  "type": "module",
  "description": "Marketing landing + documentation site for detectkit (dtk.pipelab.dev)",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "check:demo-parity": "node scripts/check-demo-parity.mjs",
    "check:tune-worker": "node scripts/check-tune-worker.mjs",
    "check": "npm run check:demo-parity && npm run check:tune-worker",
    "build:report-bundle": "node scripts/gen-report-bundle.mjs",
    "build:tune-bundle": "node scripts/gen-tune-bundle.mjs",
    "build:ui-bundle": "node scripts/gen-ui-bundle.mjs",
    "build:bundles": "npm run build:report-bundle && npm run build:tune-bundle && npm run build:ui-bundle",
    "dev": "npm run sync && astro dev",
    "start": "npm run dev",
    "build": "npm run sync && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.40.0",
    "astro": "^6.4.8",
    "sharp": "^0.35.2"
  }
}
