---
import Logo from '../components/Logo.astro';
import DbBadges from '../components/DbBadges.astro';
import ChannelBadges from '../components/ChannelBadges.astro';
import ChannelIcon from '../components/ChannelIcon.astro';
import '../styles/brand.css';
import '../styles/landing.css';

const repo = 'https://github.com/alexeiveselov92/detectkit';
const pypi = 'https://pypi.org/project/detectkit/';
const pypiStats = 'https://pypistats.org/packages/detectkit';
const docsHref = '/overview/';
const startHref = '/getting-started/installation/';

// ---- live social proof, fetched at build time. No fake fallbacks: if a source
// is unreachable the stat is simply omitted, so the hero never shows a made-up
// number. Re-fetched on every build/deploy. The PyPI figure is pypistats'
// trailing-30-day download count (mirror-excluded) — raw PyPI *downloads*
// (CI/bots included, as with every download badge), not distinct installs, so
// it's labelled "downloads/mo" and links to the source for verification. ----
const fmtCompact = (n: unknown): string | null => {
  if (typeof n !== 'number' || !isFinite(n) || n < 0) return null;
  if (n < 1000) return String(n);
  if (n < 1_000_000) return (n / 1000).toFixed(n < 10_000 ? 1 : 0).replace(/\.0$/, '') + 'k';
  return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
};
const fetchJson = async (url: string): Promise<any> => {
  try {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 4000);
    const res = await fetch(url, { headers: { 'User-Agent': 'detectkit-site' }, signal: ctrl.signal });
    clearTimeout(timer);
    return res.ok ? await res.json() : null;
  } catch {
    return null;
  }
};
const ghData = await fetchJson('https://api.github.com/repos/alexeiveselov92/detectkit');
const pypiData = await fetchJson('https://pypistats.org/api/packages/detectkit/recent');
const starsLabel = fmtCompact(ghData?.stargazers_count);
const downloadsLabel = fmtCompact(pypiData?.data?.last_month);
const heroStats = [
  starsLabel ? { kind: 'stars', label: starsLabel } : null,
  downloadsLabel ? { kind: 'downloads', label: downloadsLabel } : null,
  { kind: 'license', label: '' },
].filter((s): s is { kind: string; label: string } => s !== null);

const title = 'detectkit — metric monitoring that catches the spike';
const description =
  'Time-series anomaly detection and alerting with a dbt-like project layout. Write a metric as SQL plus a detector in YAML, run it with one command.';

// ---- hero config snippet (verbatim from the brand guide) ----
const yamlLines = [
  '<span class="c"># metrics/api_errors.yml</span>',
  '<span class="k">name</span>: <span class="s">api_error_rate</span>',
  '<span class="k">interval</span>: <span class="s">"5min"</span>',
  '',
  '<span class="k">query</span>: |',
  '  <span class="kw">SELECT</span>',
  '    toStartOfInterval(timestamp, <span class="kw">INTERVAL</span> 5 MINUTE) <span class="kw">AS</span> timestamp,',
  '    countIf(status_code &gt;= 500) / count() * 100 <span class="kw">AS</span> value',
  '  <span class="kw">FROM</span> http_requests',
  "  <span class=\"kw\">WHERE</span> timestamp &gt;= <span class=\"s\">'{{ dtk_start_time }}'</span>",
  "    <span class=\"kw\">AND</span> timestamp &lt;  <span class=\"s\">'{{ dtk_end_time }}'</span>",
  '  <span class="kw">GROUP BY</span> timestamp <span class="kw">ORDER BY</span> timestamp',
  '',
  '<span class="k">detectors</span>:',
  '  - <span class="k">type</span>: <span class="s">mad</span>',
  '    <span class="k">params</span>:',
  '      <span class="k">threshold</span>: <span class="n">3.0</span>',
  '      <span class="k">window_size</span>: <span class="n">2016</span>          <span class="c"># 7d of 5-min points</span>',
  '      <span class="k">window_weights</span>: <span class="s">exponential</span>',
  '      <span class="k">half_life</span>: <span class="s">"1d"</span>',
  '',
  '<span class="k">alerting</span>:',
  '  <span class="k">enabled</span>: <span class="n">true</span>',
  '  <span class="k">channels</span>: [<span class="s">mattermost_ops</span>]',
  '  <span class="k">consecutive_anomalies</span>: <span class="n">3</span>',
  '  <span class="k">direction</span>: <span class="s">"up"</span>',
  '  <span class="k">mentions</span>: [<span class="s">oncall_engineer</span>, <span class="s">here</span>]',
];
const yamlHtml = yamlLines.map((l) => `<div class="ln">${l}</div>`).join('');

// ---- real `dtk run` output (matches run.py + _output.py) ----
const C = { def: '#C9C2B4', cyan: '#6CC0B6', green: '#6FCB8E', yellow: '#E7B45C' };
const sp = (t, color, bold) =>
  `<span style="color:${color || C.def}${bold ? ';font-weight:700' : ''}">${t}</span>`;
const logLines = [
  'Project root: ~/monitoring',
  'Found 1 metric(s) to process',
  '',
  sp('Processing metric: api_error_rate', C.cyan, true),
  '  Config file: metrics/api_errors.yml',
  '  Steps: load, detect, alert',
  '',
  '',
  sp('  ┌─ LOAD', C.cyan, true),
  '  │ Resuming from last saved: 2026-06-19 11:55:00',
  '  │ Loading from 2026-06-19 12:00:00 to 2026-06-19 12:05:00',
  '  │ Total points: ~1 | Batch size: 10,000',
  '  │ Loading in single batch...',
  sp('  └─ Loaded 1 datapoints', C.green),
  '',
  sp('  ┌─ DETECT', C.cyan, true),
  '  │ Running 1 detector(s)...',
  '  │',
  '  │ [1/1] Detector: mad',
  '  │   Detecting from 2026-06-19 12:00:00 to 2026-06-19 12:05:00',
  '  │   Total points: ~1 | Batch size: 1,000',
  sp('  │   └─ Detected 1 anomalies', C.yellow),
  sp('  └─ Total anomalies: 1', C.yellow),
  '',
  sp('  ┌─ ALERT', C.cyan, true),
  '  │ Checking alert conditions...',
  '  │ ' + sp('⚠ Alert triggered! Sending to 1 channel(s)...', C.yellow, true),
  '  │   ' + sp('✓', C.green) + ' mattermost_ops',
  sp('  └─ Sent 1/1 alerts', C.green),
  '',
  sp('✓ Pipeline completed successfully', C.green, true),
];
const logHtml = logLines.map((l) => `<div class="ln">${l}</div>`).join('');

// ---- `dtk init-claude` output (mirrors init_claude.py + _output.py). Keep the
// rule/skill list + total in sync with detectkit/cli/assets/claude/ — the version
// suffix the real CLI prints is intentionally dropped here so it doesn't drift
// every release. See the release checklist in development/contributing.md. ----
const claudeLines = [
  'Target: ~/monitoring',
  '',
  sp('  ┌─ CLAUDE.md', C.cyan, true),
  '  └─ detectkit section ' + sp('created', C.green),
  sp('  ┌─ .claude/rules/detectkit/', C.cyan, true),
  '  │   alerting.md ' + sp('(created)', C.green),
  '  │   autotune.md ' + sp('(created)', C.green),
  '  │   cli.md ' + sp('(created)', C.green),
  '  │   detectors.md ' + sp('(created)', C.green),
  '  │   metrics.md ' + sp('(created)', C.green),
  '  │   overview.md ' + sp('(created)', C.green),
  '  └─ project.md ' + sp('(created)', C.green),
  sp('  ┌─ .claude/skills/', C.cyan, true),
  '  │   dtk-autotune/SKILL.md ' + sp('(created)', C.green),
  '  │   dtk-feedback/SKILL.md ' + sp('(created)', C.green),
  '  │   dtk-new-metric/SKILL.md ' + sp('(created)', C.green),
  '  │   dtk-setup-project/SKILL.md ' + sp('(created)', C.green),
  '  └─ dtk-tune/SKILL.md ' + sp('(created)', C.green),
  '',
  sp('Done. Claude context ready (13 created).', C.cyan, true),
];
const claudeHtml = claudeLines.map((l) => `<div class="ln">${l}</div>`).join('');

// ---- quickstart terminal: the honest DuckDB path. Verified end-to-end
// against the real engine (duckdb 1.5): the metric synthesizes its own series
// with generate_series() and one injected dip, so it runs on a fresh local
// file with no source table; `dtk run --report` REPLAYS the fired alerts into
// a self-contained HTML report (no channel dispatched → zero credentials).
// Delivering a live notification needs a channel on top (ntfy needs no token).
const cmt = (t) => sp(t, '#8A8373');
const qsLines = [
  sp('$', C.green) + ' pip install <span class="s">"detectkit[duckdb]"</span>',
  cmt('  Successfully installed detectkit · duckdb · numpy · pydantic'),
  '',
  cmt('# 3 small files — no server, no account, no credentials:'),
  cmt('#   detectkit_project.yml · profiles.yml (duckdb) · metrics/signups.yml'),
  cmt('#   the metric builds its own series in SQL, with one injected dip.'),
  '',
  sp('$', C.green) + ' dtk run <span class="s">--select</span> signups <span class="s">--report</span>',
  sp('  ┌─ LOAD', C.cyan, true) + '    ' + sp('└─ Loaded 213 datapoints', C.green),
  sp('  ┌─ DETECT', C.cyan, true) + '  · mad   ' + sp('└─ Detected 8 anomalies', C.yellow),
  sp('  ┌─ ALERT', C.cyan, true) + '   ' + cmt('(replayed into the report — nothing dispatched)'),
  sp('  ✓ Pipeline completed successfully', C.green, true),
  '  │ Report → ' + sp('reports/signups.html', C.def, true) + '  ' + sp('(8 anomalies, 8 alerts)', C.yellow),
  '',
  cmt('# open the report: the dip, the expected band, and the alerts it'),
  cmt('# fires — fully offline. Add a channel to deliver it on a live run.'),
];
const qsHtml = qsLines.map((l) => `<div class="ln">${l}</div>`).join('');

// ---- alert preview: each channel rendered the way detectkit actually emits
// it, for both Anomaly and Recovery. Slack/Mattermost = one status-colored
// webhook attachment whose whole body is a single text block ordered
// essentials-first, so the verbose tail folds behind a "Show more" toggle (one
// block, one color, like an AlertManager alert); Telegram = an escaped-HTML Bot
// API message; Email = a branded HTML card. A dashboard_url is surfaced as a
// first-class action on every channel (clickable title/link, inline link,
// button) — see the alerting config snippet above the demo. The chrome mirrors
// each platform's own UI.
const dashUrl = 'https://grafana.ops/d/api-errors';
const helpUrl = 'https://dtk.pipelab.dev/guides/reading-alerts/';

// detectkit logo as an inline SVG string (the <Logo> component can't be used
// inside a set:html string). `rx` is the avatar corner radius per platform.
const logoSvg = (size: number, rx: string) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 100 100" style="border-radius:${rx};flex:none">` +
  `<rect x="3" y="3" width="94" height="94" rx="26" fill="#D15B36"/>` +
  `<polyline points="14,62 36,62 50,22 64,62 86,62" fill="none" stroke="#FBF9F3" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>` +
  `<circle cx="50" cy="22" r="6.5" fill="#FBF9F3"/></svg>`;

// Per-state content for the webhook body. `top` (the essentials kept above the
// fold) and `tail` (the verbose evidence that folds behind "Show more") are each
// [label, value, mono] lines; `links` is one compact line of clickable labels —
// never raw URLs (a real dashboard URL can be paragraph-long) — kept above the
// fold. This mirrors the real single-attachment text body order: lead + Rule →
// Value / Expected → Links → folded tail.
const linksLine = `<a href="${dashUrl}">Dashboard</a> · <a href="${helpUrl}">How to read this alert</a>`;
const ALERT = {
  anomaly: {
    title: '🔴 [payments] Alert: api_error_rate',
    pill: 'ANOMALY',
    rule: 'min_detectors=1 · direction=up · consecutive=3',
    // The lead leads with "how long has this been going on" — the metric
    // interval, the streak length and the wall-clock duration — so a reader
    // knows immediately whether the corridor was breached just now or hours
    // ago. Interval + direction match the hero YAML (same illustrative metric).
    lead: 'Anomalous for 30m — 6 consecutive 5min intervals.',
    top: [
      ['Value', '4.2', true],
      ['Expected', '&lt;= 1.1', true],
    ] as [string, string, boolean][],
    links: linksLine,
    tail: [
      ['Quorum', '1/1 · above', false],
      ['Severity', '3.40', false],
      ['Anomaly began', '2026-06-19 11:39:00 (Europe/Moscow)', false],
      ['Latest reading', '2026-06-19 12:04:00 (Europe/Moscow)', false],
      ['Detectors', 'mad', true],
      ['Parameters', '{"threshold": 3.0, "window_size": 2016, "half_life": "1d"}', true],
    ] as [string, string, boolean][],
    emailStats: [
      ['Value', '4.2'],
      ['Expected', '&lt;= 1.1'],
      ['Severity', '3.40'],
      ['Quorum', '1/1 · above'],
      ['Started', '2026-06-19 11:39:00 (Europe/Moscow)'],
      ['Latest', '2026-06-19 12:04:00 (Europe/Moscow)'],
    ] as [string, string][],
    params: '{"threshold": 3.0, "window_size": 2016, "half_life": "1d"}',
  },
  recovery: {
    title: '🟢 [payments] Alert cleared: api_error_rate',
    pill: 'RECOVERED',
    rule: 'min_detectors=1 · direction=up · consecutive=3',
    lead: 'The alert condition no longer holds — the metric is back within expected bounds. Incident lasted 1h (12 consecutive 5min intervals).',
    top: [
      ['Value', '1.0', true],
      ['Expected', '&lt;= 1.1', true],
    ] as [string, string, boolean][],
    links: linksLine,
    tail: [
      ['Anomaly began', '2026-06-19 11:36:00 (Europe/Moscow)', false],
      ['Alert fired', '2026-06-19 11:46:00 (Europe/Moscow)', false],
      ['Recovered', '2026-06-19 12:36:00 (Europe/Moscow)', false],
      ['Detectors', 'mad', true],
    ] as [string, string, boolean][],
    emailStats: [
      ['Value', '1.0'],
      ['Expected', '&lt;= 1.1'],
      ['Started', '2026-06-19 11:36:00 (Europe/Moscow)'],
      ['Cleared', '2026-06-19 12:36:00 (Europe/Moscow)'],
      ['Detector', 'mad'],
    ] as [string, string][],
    params: '',
  },
};

// Description first, then the firing rule set apart as a bold "Rule" label + an
// inline-code chip sitting right above the value/expected fields it explains —
// the same description → Rule → evidence order on every channel (anomaly and
// recovery alike), mirroring the real channels.
const ruleLead = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  const chip = `<strong>Rule</strong> <code>${d.rule}</code>`;
  return `${d.lead}<br>${chip}`;
};

// Slack / Mattermost — one status-colored attachment (the metric name is the
// clickable attachment title; mentions ride in the top-level message text). The
// whole body is a single stacked text block: the essentials (Value / Expected /
// Links) stay above the fold, and the verbose tail collapses behind a native
// "Show more" toggle — mirroring how both clients fold only the attachment text
// while the title, color bar and footer/logo stay in view.
const bodyLine = ([k, v, mono]: [string, string, boolean]) =>
  `<div class="att-line"><span class="lk">${k}</span> ${mono ? `<code>${v}</code>` : v}</div>`;

const attachmentHtml = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  return (
    '<div class="att-mentions"><span class="ment">@oncall_engineer</span> <span class="ment">@here</span></div>' +
    '<div class="attachment">' +
    '<div class="bar"></div>' +
    '<div class="content">' +
    `<a class="att-title" href="${dashUrl}">${d.title}<span class="ext"> ↗</span></a>` +
    `<div class="att-lead">${ruleLead(sev)}</div>` +
    '<div class="att-body">' +
    d.top.map(bodyLine).join('') +
    `<div class="att-line"><span class="lk">Links</span> ${d.links}</div>` +
    '</div>' +
    '<details class="att-more"><summary aria-label="Show more"></summary>' +
    `<div class="att-body att-tail">${d.tail.map(bodyLine).join('')}</div>` +
    '</details>' +
    `<div class="att-footer">${logoSvg(13, '3px')}<span>detectkit · payments</span></div>` +
    '</div></div>'
  );
};

const slackPanelHtml = (sev: 'anomaly' | 'recovery') =>
  '<div class="chat-msg">' +
  logoSvg(38, '9px') +
  '<div class="chat-body"><div class="chat-head">' +
  '<span class="chat-name">detectkit</span><span class="chat-tag">APP</span><span class="chat-time">12:04</span>' +
  '</div>' +
  attachmentHtml(sev) +
  '</div></div>';

const mmPanelHtml = (sev: 'anomaly' | 'recovery') =>
  '<div class="chat-msg">' +
  logoSvg(38, '50%') +
  '<div class="chat-body"><div class="chat-head">' +
  '<span class="chat-name">detectkit</span><span class="chat-tag bot">BOT</span><span class="chat-time">12:04</span>' +
  '</div>' +
  attachmentHtml(sev) +
  '</div></div>';

// Telegram — an escaped-HTML message: status dot, bold headline, rule, evidence
// in <code>, an inline "Open dashboard" link, then mentions.
const tgCheck =
  '<svg width="13" height="13" viewBox="0 0 24 24" fill="#3390EC"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>';
const tgTextHtml = (sev: 'anomaly' | 'recovery') => {
  const dot = sev === 'anomaly' ? '🔴' : '🟢';
  const word = sev === 'anomaly' ? 'Anomaly' : 'Recovered';
  const head =
    `${dot} <b>[payments] ${word} · api_error_rate</b>\n\n` +
    (sev === 'anomaly'
      ? 'Anomalous for 30m — 6 consecutive 5min intervals.\n'
      : 'The alert condition no longer holds — the metric is back within expected bounds. Incident lasted 1h (12 consecutive 5min intervals).\n') +
    '<b>Rule</b> <code>min_detectors=1 · direction=up · consecutive=3</code>\n\n';
  const evidence =
    sev === 'anomaly'
      ? '• Value: <code>4.2</code> · Expected: <code>&lt;= 1.1</code>\n' +
        '• Quorum: <code>1/1 · above</code>\n' +
        '• Severity: <code>3.40</code>\n' +
        '• Anomaly began: <code>2026-06-19 11:39:00 (Europe/Moscow)</code> · Latest reading: <code>2026-06-19 12:04:00 (Europe/Moscow)</code>\n' +
        '• Detector: <code>mad</code>\n' +
        '• Parameters: <code>{"threshold": 3.0, "window_size": 2016, "half_life": "1d"}</code>\n'
      : '• Value: <code>1.0</code> · Expected: <code>&lt;= 1.1</code>\n' +
        '• Anomaly began: <code>2026-06-19 11:36:00 (Europe/Moscow)</code> · Alert fired: <code>2026-06-19 11:46:00 (Europe/Moscow)</code> · Recovered: <code>2026-06-19 12:36:00 (Europe/Moscow)</code>\n' +
        '• Detector: <code>mad</code>\n';
  return (
    head +
    evidence +
    `\n<a href="${dashUrl}">Open dashboard</a> · <a href="${helpUrl}">How to read this alert</a>\n\n` +
    '<span class="ment">@oncall_engineer</span>'
  );
};

const tgPanelHtml = (sev: 'anomaly' | 'recovery') =>
  '<div class="tg-msg">' +
  logoSvg(34, '50%') +
  '<div class="tg-bubble">' +
  `<div class="tg-name">detectkit ${tgCheck}</div>` +
  `<div class="tg-text">${tgTextHtml(sev)}</div>` +
  '<div class="tg-meta">12:04</div>' +
  '</div></div>';

// Email — a branded HTML card inside a mail-client chrome.
const emailStatsHtml = (stats: [string, string][]) =>
  '<div class="ec-grid">' +
  stats
    .map(
      ([k, v]) =>
        `<div class="ec-cell"><div class="ec-k">${k}</div><div class="ec-v">${v}</div></div>`
    )
    .join('') +
  '</div>';

const emailCardHtml = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  const paramsBlock = d.params
    ? `<div class="ec-plabel">Detector · mad</div><div class="ec-params">${d.params}</div>`
    : '';
  return (
    '<div class="email-card">' +
    '<div class="ec-accent"></div>' +
    '<div class="ec-head">' +
    logoSvg(26, '6px') +
    '<span class="ec-brand">detectkit</span>' +
    `<span class="ec-pill">${d.pill}</span>` +
    '</div>' +
    '<div class="ec-eyebrow">payments</div>' +
    '<div class="ec-title">api_error_rate</div>' +
    `<div class="ec-lead">${ruleLead(sev)}</div>` +
    emailStatsHtml(d.emailStats) +
    paramsBlock +
    `<a class="ec-btn" href="${dashUrl}">Open dashboard →</a>` +
    '<div class="ec-foot">Sent by detectkit · payments · CC: oncall_engineer · ' +
    `<a class="ec-foot-link" href="${helpUrl}">How to read this alert →</a></div>` +
    '</div>'
  );
};

const emailPanelHtml = (sev: 'anomaly' | 'recovery') =>
  '<div class="email-msg">' +
  '<div class="email-head">' +
  logoSvg(34, '50%') +
  '<div class="email-meta">' +
  '<div class="email-from"><b>detectkit alerts</b> <span>&lt;alerts@detectkit.dev&gt;</span></div>' +
  '<div class="email-sub">to team@example.com · 12:04</div>' +
  '</div>' +
  '<svg class="email-reply" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9C2B4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>' +
  '</div>' +
  emailCardHtml(sev) +
  '</div>';

// Discord — dark chat surface (its own backdrop, like Telegram's wallpaper,
// since the embed's own dark fill differs from the message-list background
// around it), the brand bot avatar + a BOT tag, one status-colored embed.
// Embeds have no "Show more" fold, so the verbose tail that folds on
// Slack/Mattermost instead rides in a compact inline field grid
// (discord.py's `_fields`); detector params ride in the description as a
// fenced code block. Field values render plain (no backticks) — only the
// Value/Expected line is bold+code, mirroring `_build_description` exactly.
const discordFieldsHtml = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  const fields = d.tail.filter(([k]) => k !== 'Parameters');
  return (
    '<div class="pfd-fields">' +
    fields
      .map(([k, v]) => `<div class="pfd-field"><div class="pfd-fk">${k}</div><div class="pfd-fv">${v}</div></div>`)
      .join('') +
    '</div>'
  );
};

const discordEmbedHtml = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  const valueLine = d.top.map(([k, v]) => `<strong>${k}</strong> <code>${v}</code>`).join(' · ');
  const paramsHtml =
    sev === 'anomaly'
      ? `<div class="pfd-plabel"><strong>Parameters</strong></div><pre class="pfd-pblock">${d.params}</pre>`
      : '';
  return (
    '<div class="pfd-embed">' +
    '<div class="pfd-bar"></div>' +
    '<div class="pfd-content">' +
    `<a class="pfd-title" href="${dashUrl}">${d.title}</a>` +
    `<div class="pfd-desc">${ruleLead(sev)}</div>` +
    `<div class="pfd-desc">${valueLine}</div>` +
    `<div class="pfd-desc"><strong>Links</strong> ${d.links}</div>` +
    paramsHtml +
    discordFieldsHtml(sev) +
    `<div class="pfd-footer">${logoSvg(13, '3px')}<span>detectkit · payments</span><span class="pfd-fdot">•</span><span>12:04</span></div>` +
    '</div></div>'
  );
};

const discordPanelHtml = (sev: 'anomaly' | 'recovery') =>
  '<div class="pfd-msg">' +
  logoSvg(38, '50%') +
  '<div class="pfd-body">' +
  '<div class="pfd-head">' +
  '<span class="pfd-name">detectkit</span><span class="pfd-tag">BOT</span><span class="pfd-time">Today at 12:04</span>' +
  '</div>' +
  discordEmbedHtml(sev) +
  '</div></div>';

// Microsoft Teams — light chrome, posted under the Power Automate
// **Workflows** app's own identity (a generic app icon — deliberately no
// detectkit branding/avatar on this path, see teams.py's docstring): an
// Adaptive Card with a colored headline TextBlock, a monospace Rule line, a
// FactSet mirroring the webhook tail, and Action.OpenUrl buttons.
const teamsFactsHtml = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  const facts = sev === 'anomaly' ? d.tail.filter(([k]) => k !== 'Parameters') : d.tail;
  return (
    '<div class="pft-facts">' +
    [...d.top, ...facts]
      .map(([k, v]) => `<div class="pft-fact"><div class="pft-fk">${k}</div><div class="pft-fv">${v}</div></div>`)
      .join('') +
    '</div>'
  );
};

const teamsPanelHtml = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  const flowIcon =
    '<svg viewBox="0 0 24 24" fill="none" stroke="#68769c" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
    '<circle cx="6" cy="6" r="2.4"/><circle cx="18" cy="6" r="2.4"/><circle cx="12" cy="18" r="2.4"/>' +
    '<path d="M7.9 7.3 10.5 16M16.1 7.3 13.5 16M8.4 6h7.2"/></svg>';
  return (
    '<div class="pft-msg">' +
    `<div class="pft-avatar">${flowIcon}</div>` +
    '<div class="pft-body">' +
    '<div class="pft-head"><span class="pft-name">Workflows</span><span class="pft-tag">APP</span><span class="pft-time">12:04</span></div>' +
    '<div class="pft-card">' +
    `<div class="pft-title">${d.title}</div>` +
    `<div class="pft-lead">${d.lead}</div>` +
    `<div class="pft-rule">Rule: ${d.rule}</div>` +
    teamsFactsHtml(sev) +
    (sev === 'anomaly' ? `<div class="pft-params">${d.params}</div>` : '') +
    '<div class="pft-actions">' +
    `<a class="pft-btn" href="${dashUrl}">Dashboard</a>` +
    `<a class="pft-btn" href="${helpUrl}">How to read this alert</a>` +
    '</div>' +
    '<div class="pft-foot">detectkit · payments</div>' +
    '</div></div></div>'
  );
};

// Google Chat — light Cards v2 card; the card has no color bar (the status
// dot in the title is the only color cue), so the header carries the brand
// avatar + "detectkit · payments" subtitle instead. The Rule line is bold
// label + PLAIN text (not a code chip) — googlechat.py's `rule_line` never
// wraps it in `<code>`, an honest quirk kept here. decoratedText-style
// evidence rows, then a button row.
const gchatRowsHtml = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  const rows = sev === 'anomaly' ? d.tail.filter(([k]) => k !== 'Parameters') : d.tail;
  return (
    '<div class="pfg-rows">' +
    [...d.top, ...rows]
      .map(([k, v]) => `<div class="pfg-row"><div class="pfg-rk">${k}</div><div class="pfg-rv">${v}</div></div>`)
      .join('') +
    '</div>'
  );
};

const gchatPanelHtml = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  return (
    '<div class="pfg-card">' +
    '<div class="pfg-head">' +
    logoSvg(32, '50%') +
    '<div class="pfg-headtext">' +
    `<div class="pfg-title">${d.title}</div>` +
    '<div class="pfg-sub">detectkit · payments</div>' +
    '</div></div>' +
    '<div class="pfg-sec">' +
    `<div class="pfg-lead">${d.lead}<br><strong>Rule</strong> ${d.rule}</div>` +
    '</div>' +
    '<div class="pfg-sec">' +
    gchatRowsHtml(sev) +
    (sev === 'anomaly'
      ? `<div class="pfg-params"><strong>Parameters</strong><br>${d.params}</div>`
      : '') +
    '</div>' +
    '<div class="pfg-sec pfg-actions">' +
    `<a class="pfg-btn" href="${dashUrl}">Dashboard</a>` +
    `<a class="pfg-btn" href="${helpUrl}">How to read this alert</a>` +
    '</div>' +
    '</div>'
  );
};

// ntfy — the app delivers a push notification, not a branded card: no color
// bar, no bot avatar, no status dot (ntfy.py strips it) — the kind's TAG
// EMOJI is the only status cue, leading the title. The body is the plain-text
// default template verbatim (lead + Rule + evidence lines), and a priority
// line surfaces ntfy's real per-kind default (p4 anomaly/error, p3 else).
const ntfyTagEmoji: Record<'anomaly' | 'recovery', string> = { anomaly: '🚨', recovery: '✅' };
const ntfyBellSvg =
  '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#317F6F" stroke-width="2" ' +
  'stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>' +
  '<path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>';

const ntfyBodyText = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  const val = (label: string) => (d.tail.find(([k]) => k === label) ?? ['', ''])[1];
  const value = d.top[0][1];
  const expected = d.top[1][1];
  const lines = [d.lead, `Rule: ${d.rule}`, '', `Value: ${value} | Expected: ${expected}`];
  if (sev === 'anomaly') {
    lines.push(`Quorum: ${val('Quorum')}`);
    lines.push(`Severity: ${val('Severity')}`);
    lines.push(`Anomaly began: ${val('Anomaly began')} | Latest reading: ${val('Latest reading')}`);
    lines.push(`Detectors: ${val('Detectors')}`);
    lines.push(`Parameters: ${d.params}`);
  } else {
    lines.push(
      `Anomaly began: ${val('Anomaly began')} | Alert fired: ${val('Alert fired')} | Recovered: ${val('Recovered')}`
    );
    lines.push(`Detectors: ${val('Detectors')}`);
  }
  lines.push('', `Dashboard: ${dashUrl}`, `How to read this alert: ${helpUrl}`, '', '@oncall_engineer');
  return lines.join('\n');
};

const ntfyPanelHtml = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  const title = d.title.slice(d.title.indexOf(' ') + 1); // strip the leading status-dot emoji
  const priority = sev === 'anomaly' ? 'Priority 4 · high' : 'Priority 3 · default';
  return (
    '<div class="pfn-msg">' +
    '<div class="pfn-app">' +
    `<span class="pfn-appicon">${ntfyBellSvg}</span>` +
    '<span class="pfn-appname">ntfy</span>' +
    '<span class="pfn-when">now</span>' +
    '</div>' +
    `<div class="pfn-title">${ntfyTagEmoji[sev]} ${title}</div>` +
    `<div class="pfn-body">${ntfyBodyText(sev)}</div>` +
    `<div class="pfn-meta">${priority}</div>` +
    '</div>'
  );
};

// ---- Detectors explainer: five "corridors of normal", each shown on the
// metric shape it is built for (mad = noisy, zscore = clean bell, iqr = skewed,
// autoreg = patterned, manual = hard-bounded). A rolling-median corridor is
// recomputed per series (fixed for manual_bounds; the AR forecast for autoreg)
// on a 900×380 grid. The SVG holds only graphics;
// every text annotation (legend, axis, anomaly callout, max/min) is an HTML
// overlay so it stays legible when the chart scales down on mobile. Colors are
// .dx-* tokens in landing.css (no hardcoded hex). Geometry mirrors the brand guide.
const dxExplainer = (() => {
  const N = 46;
  const W = 900;
  const H = 380;
  const x0 = 70;
  const x1 = W - 74;
  const y1 = H - 56;
  const plotW = x1 - x0;
  const plotH = y1 - 66;
  const X = (i) => +(x0 + (i / (N - 1)) * plotW).toFixed(1);
  const Yv = (v) => +(y1 - v * plotH).toFixed(1);
  const pct = (v, span) => +((v / span) * 100).toFixed(2);
  const median = (a) => {
    const s = [...a].sort((p, q) => p - q);
    const m = s.length >> 1;
    return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
  };
  const clamp = (v) => Math.max(0.04, Math.min(0.98, v));
  const grid = [0.25, 0.5, 0.75]
    .map((v) => `<line class="dx-grid" x1="${x0}" y1="${Yv(v)}" x2="${x1}" y2="${Yv(v)}"/>`)
    .join('');

  // Each detector's series is the kind of metric it handles best.
  const SERIES = {
    // mad — messy, jittery signal with a sharp final spike (robust default)
    mad: [
      0.45, 0.4, 0.48, 0.42, 0.38, 0.46, 0.41, 0.49, 0.43, 0.39, 0.47, 0.42,
      0.5, 0.44, 0.4, 0.48, 0.43, 0.51, 0.45, 0.41, 0.49, 0.44, 0.42, 0.48,
      0.45, 0.4, 0.47, 0.5, 0.44, 0.42, 0.48, 0.54, 0.9, 0.58, 0.46, 0.42,
      0.49, 0.44, 0.4, 0.47, 0.42, 0.5, 0.45, 0.41, 0.48, 0.44,
    ],
    // iqr — skewed signal: low baseline with occasional upward tails
    iqr: [
      0.34, 0.31, 0.36, 0.33, 0.3, 0.35, 0.32, 0.5, 0.37, 0.33, 0.31, 0.36,
      0.34, 0.49, 0.33, 0.3, 0.35, 0.32, 0.38, 0.34, 0.31, 0.48, 0.35, 0.33,
      0.3, 0.36, 0.34, 0.32, 0.5, 0.33, 0.31, 0.36, 0.9, 0.42, 0.34, 0.31,
      0.35, 0.33, 0.3, 0.47, 0.34, 0.32, 0.36, 0.33, 0.31, 0.35,
    ],
    // manual_bounds — steady signal that briefly breaches a hard ceiling
    manual: [
      0.48, 0.45, 0.5, 0.47, 0.44, 0.49, 0.46, 0.51, 0.47, 0.45, 0.5, 0.46,
      0.52, 0.48, 0.45, 0.49, 0.47, 0.51, 0.48, 0.46, 0.5, 0.47, 0.45, 0.49,
      0.47, 0.44, 0.48, 0.51, 0.47, 0.45, 0.49, 0.56, 0.86, 0.59, 0.48, 0.45,
      0.5, 0.46, 0.44, 0.49, 0.46, 0.51, 0.47, 0.45, 0.49, 0.46,
    ],
  };
  // zscore — clean, smooth, bell-shaped signal with a single tail event
  const zscoreSeries = () => {
    const a = [];
    for (let i = 0; i < N; i++) {
      a.push(+(0.5 + 0.085 * Math.sin(i * 0.46) + 0.015 * Math.cos(i * 1.1)).toFixed(3));
    }
    a[32] = 0.9;
    return a;
  };
  // autoreg — a smooth, strongly-patterned wave. The anomaly sits mid-range (a
  // level detector would call it normal) but breaks the wave's rhythm: the
  // forecast says "peak", the value says "flat". The corridor follows the AR
  // prediction (the clean pattern), not a rolling location statistic.
  const AR = (() => {
    const clean = [];
    for (let i = 0; i < N; i++) {
      clean.push(+(0.5 + 0.16 * Math.sin(i * 0.55) + 0.03 * Math.sin(i * 0.23)).toFixed(3));
    }
    const values = [...clean];
    values[37] = 0.5; // dead-center of the range — wrong only for the shape
    return { clean, values, anomIdx: 37 };
  })();

  const GLYPH = {
    mad:
      '<svg viewBox="0 0 40 40" class="dx-gl"><rect class="dx-gl-area" x="14" y="6" width="12" height="28" rx="3" fill-opacity="0.13"/><line class="dx-gl-stroke" x1="20" y1="6" x2="20" y2="34" stroke-width="2.4" stroke-linecap="round"/><line class="dx-gl-stroke" x1="14" y1="6" x2="26" y2="6" stroke-width="2.4" stroke-linecap="round"/><line class="dx-gl-stroke" x1="14" y1="34" x2="26" y2="34" stroke-width="2.4" stroke-linecap="round"/><circle class="dx-gl-solid" cx="20" cy="20" r="4"/></svg>',
    zscore:
      '<svg viewBox="0 0 44 34" class="dx-gl"><path class="dx-gl-area" d="M3 31 C16 31 16 6 22 6 C28 6 28 31 41 31" fill-opacity="0.12"/><path class="dx-gl-stroke" d="M3 31 C16 31 16 6 22 6 C28 6 28 31 41 31" fill="none" stroke-width="2.2" stroke-linecap="round"/><line class="dx-gl-stroke" x1="22" y1="6" x2="22" y2="31" stroke-width="1.4" stroke-dasharray="2 3"/><circle class="dx-gl-solid" cx="38" cy="29" r="2.6"/></svg>',
    iqr:
      '<svg viewBox="0 0 44 34" class="dx-gl"><line class="dx-gl-stroke" x1="4" y1="17" x2="13" y2="17" stroke-width="2" stroke-linecap="round"/><line class="dx-gl-stroke" x1="31" y1="17" x2="36" y2="17" stroke-width="2" stroke-linecap="round"/><rect class="dx-gl-box" x="13" y="8" width="18" height="18" rx="3" fill-opacity="0.13" stroke-width="2.2"/><line class="dx-gl-stroke" x1="22" y1="8" x2="22" y2="26" stroke-width="2.2"/><circle class="dx-gl-solid" cx="41" cy="17" r="2.8"/></svg>',
    autoreg:
      '<svg viewBox="0 0 44 34" class="dx-gl"><path class="dx-gl-stroke" d="M3 25 C7 11 11 8 15 14 C18 18.5 20 22 24 20" fill="none" stroke-width="2.2" stroke-linecap="round"/><path class="dx-gl-stroke" d="M24 20 C28 17.5 32 11 40 8" fill="none" stroke-width="1.8" stroke-dasharray="2.5 3" stroke-linecap="round"/><circle class="dx-gl-solid" cx="35" cy="26" r="2.8"/></svg>',
    manual:
      '<svg viewBox="0 0 40 40" class="dx-gl"><line class="dx-gl-stroke" x1="5" y1="11" x2="35" y2="11" stroke-width="2.4" stroke-dasharray="6 4" stroke-linecap="round"/><line class="dx-gl-stroke" x1="5" y1="29" x2="35" y2="29" stroke-width="2.4" stroke-dasharray="6 4" stroke-linecap="round"/><path class="dx-gl-solid" d="M20 18 l4 5 h-8 z"/><path class="dx-gl-solid" d="M20 22 l-4 -5 h8 z" opacity="0.4"/></svg>',
  };

  const META = {
    mad: {
      code: 'mad',
      name: 'Median absolute deviation',
      desc: 'Measures the typical distance from the median. A handful of wild spikes barely move it — the most robust default.',
      formula: 'median ± 3 × MAD',
      best: 'Spiky, noisy metrics with outliers in their history.',
      anom: '3.40 σ',
      cfg: { hUp: 0.135, hDn: 0.135 },
    },
    zscore: {
      code: 'zscore',
      name: 'Z-score',
      desc: 'Classic mean ± k standard deviations. Fast and simple, but one big outlier inflates the band — keep it for clean data.',
      formula: 'mean ± 3 × σ',
      best: 'Clean, roughly bell-shaped metrics.',
      anom: 'z = 4.1',
      cfg: { hUp: 0.13, hDn: 0.13 },
    },
    iqr: {
      code: 'iqr',
      name: 'Interquartile range',
      desc: 'Builds the corridor from the middle 50% of values, then extends fences 1.5×IQR out. Comfortable with skewed, long-tailed data.',
      formula: '[ Q1 − 1.5·IQR , Q3 + 1.5·IQR ]',
      best: 'Skewed distributions and one-sided outliers.',
      anom: 'beyond fence',
      cfg: { hUp: 0.21, hDn: 0.1 },
    },
    autoreg: {
      code: 'autoreg',
      name: 'Autoregressive forecast',
      desc: 'Predicts each point from the few just before it, then flags what misses the forecast. Catches values that are normal in absolute terms but wrong for the shape of the curve — dips, stalls, broken rhythm.',
      formula: 'ŷ ± 3 × σ_residual',
      best: 'Smooth, strongly-patterned metrics where dynamics matter, not just level.',
      anom: '6.9 σ_r',
      cfg: { hUp: 0.08, hDn: 0.08 },
    },
    manual: {
      code: 'manual_bounds',
      name: 'Manual bounds',
      desc: 'No statistics at all — you set hard floor and ceiling values. Alerts the instant a metric crosses a known SLA line.',
      formula: 'value < min  or  value > max',
      best: 'Known SLAs and hard business limits.',
      anom: '> max',
      cfg: null,
    },
  };

  const build = (id) => {
    const m = META[id];
    const manual = id === 'manual';
    const autoreg = id === 'autoreg';
    const values = id === 'zscore' ? zscoreSeries() : autoreg ? AR.values : SERIES[id];
    // autoreg's dashed center IS the prediction ŷ — the corridor tracks the
    // expected pattern, so the mid-range dot falls outside it.
    const center = autoreg
      ? AR.clean
      : values.map((_, i) => median(values.slice(Math.max(0, i - 4), Math.min(N, i + 5))));
    let upper, lower;
    if (manual) {
      upper = values.map(() => 0.7);
      lower = values.map(() => 0.2);
    } else {
      upper = center.map((c) => clamp(c + m.cfg.hUp));
      lower = center.map((c) => clamp(c - m.cfg.hDn));
    }
    const lineP = 'M' + values.map((v, i) => X(i) + ',' + Yv(v)).join(' L');
    const bandP =
      'M' +
      upper.map((v, i) => X(i) + ',' + Yv(v)).join(' L') +
      ' L' +
      lower.map((v, i) => X(i) + ',' + Yv(v)).reverse().join(' L') +
      ' Z';
    const centerP = manual ? '' : 'M' + center.map((v, i) => X(i) + ',' + Yv(v)).join(' L');
    const ai = autoreg ? AR.anomIdx : values.indexOf(Math.max(...values));
    const ax = X(ai);
    const ay = Yv(values[ai]);

    const svg =
      `<svg class="dx-svg" viewBox="0 0 ${W} ${H}" aria-hidden="true">` +
      grid +
      `<line class="dx-axisline" x1="${x0}" y1="${y1 + 1}" x2="${x1}" y2="${y1 + 1}" stroke-width="1.4"/>` +
      `<path class="dx-band" d="${bandP}" fill-opacity="0.12"/>` +
      (manual
        ? `<line class="dx-bound" x1="${x0}" y1="${Yv(0.7)}" x2="${x1}" y2="${Yv(0.7)}" stroke-width="2.2" stroke-dasharray="9 6"/>` +
          `<line class="dx-bound" x1="${x0}" y1="${Yv(0.2)}" x2="${x1}" y2="${Yv(0.2)}" stroke-width="2.2" stroke-dasharray="9 6"/>`
        : `<path class="dx-center" d="${centerP}" fill="none" stroke-width="1.4" stroke-dasharray="2 6" stroke-opacity="0.55"/>`) +
      `<path class="dx-line" d="${lineP}" fill="none" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" pathLength="1"/>` +
      `<circle class="dx-anom-halo" cx="${ax}" cy="${ay}" r="9"/>` +
      `<circle class="dx-anom" cx="${ax}" cy="${ay}" r="6" stroke-width="2.5"/>` +
      `</svg>`;

    const bounds = manual
      ? [
          { label: 'max', top: pct(Yv(0.7), H) },
          { label: 'min', top: pct(Yv(0.2), H) },
        ]
      : [];

    return {
      id,
      ...m,
      svg,
      glyph: GLYPH[id],
      bounds,
      calloutLeft: pct(ax, W),
      calloutTop: pct(ay, H),
    };
  };

  return { list: ['mad', 'zscore', 'iqr', 'autoreg', 'manual'].map(build) };
})();
