---
import Logo from '../components/Logo.astro';
import DbBadges from '../components/DbBadges.astro';
import ChannelIcon from '../components/ChannelIcon.astro';
import '../styles/brand.css';
import '../styles/landing.css';

const repo = 'https://github.com/alexeiveselov92/detectkit';
const pypi = 'https://pypi.org/project/detectkit/';
const pypiStats = 'https://pypistats.org/packages/detectkit';
const docsHref = '/overview/';
const startHref = '/getting-started/installation/';

// ---- live social proof, fetched at build time. No fake fallbacks: if a source
// is unreachable the stat is simply omitted, so the hero never shows a made-up
// number. Re-fetched on every build/deploy. The PyPI figure is pypistats'
// trailing-30-day download count (mirror-excluded) — raw PyPI *downloads*
// (CI/bots included, as with every download badge), not distinct installs, so
// it's labelled "downloads/mo" and links to the source for verification. ----
const fmtCompact = (n: unknown): string | null => {
  if (typeof n !== 'number' || !isFinite(n) || n < 0) return null;
  if (n < 1000) return String(n);
  if (n < 1_000_000) return (n / 1000).toFixed(n < 10_000 ? 1 : 0).replace(/\.0$/, '') + 'k';
  return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
};
const fetchJson = async (url: string): Promise<any> => {
  try {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 4000);
    const res = await fetch(url, { headers: { 'User-Agent': 'detectkit-site' }, signal: ctrl.signal });
    clearTimeout(timer);
    return res.ok ? await res.json() : null;
  } catch {
    return null;
  }
};
const ghData = await fetchJson('https://api.github.com/repos/alexeiveselov92/detectkit');
const pypiData = await fetchJson('https://pypistats.org/api/packages/detectkit/recent');
const starsLabel = fmtCompact(ghData?.stargazers_count);
const downloadsLabel = fmtCompact(pypiData?.data?.last_month);
const heroStats = [
  starsLabel ? { kind: 'stars', label: starsLabel } : null,
  downloadsLabel ? { kind: 'downloads', label: downloadsLabel } : null,
  { kind: 'license', label: '' },
].filter((s): s is { kind: string; label: string } => s !== null);

const title = 'detectkit — metric monitoring that catches the spike';
const description =
  'Time-series anomaly detection and alerting with a dbt-like project layout. Write a metric as SQL plus a detector in YAML, run it with one command.';

// ---- hero config snippet (verbatim from the brand guide) ----
const yamlLines = [
  '<span class="c"># metrics/api_errors.yml</span>',
  '<span class="k">name</span>: <span class="s">api_error_rate</span>',
  '<span class="k">interval</span>: <span class="s">"5min"</span>',
  '',
  '<span class="k">query</span>: |',
  '  <span class="kw">SELECT</span>',
  '    toStartOfInterval(timestamp, <span class="kw">INTERVAL</span> 5 MINUTE) <span class="kw">AS</span> timestamp,',
  '    countIf(status_code &gt;= 500) / count() * 100 <span class="kw">AS</span> value',
  '  <span class="kw">FROM</span> http_requests',
  "  <span class=\"kw\">WHERE</span> timestamp &gt;= <span class=\"s\">'{{ dtk_start_time }}'</span>",
  "    <span class=\"kw\">AND</span> timestamp &lt;  <span class=\"s\">'{{ dtk_end_time }}'</span>",
  '  <span class="kw">GROUP BY</span> timestamp <span class="kw">ORDER BY</span> timestamp',
  '',
  '<span class="k">detectors</span>:',
  '  - <span class="k">type</span>: <span class="s">mad</span>',
  '    <span class="k">params</span>:',
  '      <span class="k">threshold</span>: <span class="n">3.0</span>',
  '      <span class="k">window_size</span>: <span class="n">2016</span>          <span class="c"># 7d of 5-min points</span>',
  '      <span class="k">window_weights</span>: <span class="s">exponential</span>',
  '      <span class="k">half_life</span>: <span class="s">"1d"</span>',
  '',
  '<span class="k">alerting</span>:',
  '  <span class="k">enabled</span>: <span class="n">true</span>',
  '  <span class="k">channels</span>: [<span class="s">mattermost_ops</span>]',
  '  <span class="k">consecutive_anomalies</span>: <span class="n">3</span>',
  '  <span class="k">direction</span>: <span class="s">"up"</span>',
  '  <span class="k">mentions</span>: [<span class="s">oncall_engineer</span>, <span class="s">here</span>]',
];
const yamlHtml = yamlLines.map((l) => `<div class="ln">${l}</div>`).join('');

// ---- real `dtk run` output (matches run.py + _output.py) ----
const C = { def: '#C9C2B4', cyan: '#6CC0B6', green: '#6FCB8E', yellow: '#E7B45C' };
const sp = (t, color, bold) =>
  `<span style="color:${color || C.def}${bold ? ';font-weight:700' : ''}">${t}</span>`;
const logLines = [
  'Project root: ~/monitoring',
  'Found 1 metric(s) to process',
  '',
  sp('Processing metric: api_error_rate', C.cyan, true),
  '  Config file: metrics/api_errors.yml',
  '  Steps: load, detect, alert',
  '',
  sp('  ┌─ LOAD', C.cyan, true),
  '  │ Resuming from last saved: 2026-06-19 11:55:00',
  '  │ Loading from 2026-06-19 12:00:00 to 2026-06-19 12:05:00',
  '  │ Total points: ~1 | Batch size: 10,000',
  '  │ Loading in single batch...',
  sp('  └─ Loaded 1 datapoints', C.green),
  '',
  sp('  ┌─ DETECT', C.cyan, true),
  '  │ Running 1 detector(s)...',
  '  │',
  '  │ [1/1] Detector: mad',
  '  │   Detecting from 2026-06-19 12:00:00 to 2026-06-19 12:05:00',
  '  │   Total points: ~1 | Batch size: 1,000',
  sp('  │   └─ Detected 1 anomalies', C.yellow),
  sp('  └─ Total anomalies: 1', C.yellow),
  '',
  sp('  ┌─ ALERT', C.cyan, true),
  '  │ Checking alert conditions...',
  '  │ ' + sp('⚠ Alert triggered! Sending to 1 channel(s)...', C.yellow, true),
  '  │   ' + sp('✓', C.green) + ' mattermost_ops',
  sp('  └─ Sent 1/1 alerts', C.green),
  '',
  sp('✓ Pipeline completed successfully', C.green, true),
];
const logHtml = logLines.map((l) => `<div class="ln">${l}</div>`).join('');

// ---- `dtk init-claude` output (matches init_claude.py + _output.py) ----
const claudeLines = [
  'Target: ~/monitoring',
  '',
  sp('  ┌─ CLAUDE.md', C.cyan, true),
  '  └─ detectkit section ' + sp('created', C.green),
  sp('  ┌─ .claude/rules/detectkit/', C.cyan, true),
  '  │   overview.md ' + sp('(created)', C.green),
  '  │   cli.md ' + sp('(created)', C.green),
  '  │   project.md ' + sp('(created)', C.green),
  '  │   metrics.md ' + sp('(created)', C.green),
  '  │   detectors.md ' + sp('(created)', C.green),
  '  └─ alerting.md ' + sp('(created)', C.green),
  sp('  ┌─ .claude/skills/', C.cyan, true),
  '  │   dtk-setup-project/SKILL.md ' + sp('(created)', C.green),
  '  │   dtk-new-metric/SKILL.md ' + sp('(created)', C.green),
  '  └─ dtk-feedback/SKILL.md ' + sp('(created)', C.green),
  '',
  sp('Done. Claude context ready (10 created).', C.cyan, true),
];
const claudeHtml = claudeLines.map((l) => `<div class="ln">${l}</div>`).join('');

// ---- alert preview: each channel rendered the way detectkit actually emits
// it, for both Anomaly and Recovery. Slack/Mattermost = a fields-based webhook
// attachment; Telegram = an escaped-HTML Bot API message; Email = a branded
// HTML card. A dashboard_url is surfaced as a first-class action on every
// channel (clickable title/link, inline link, button) — see the alerting
// config snippet above the demo. The chrome mirrors each platform's own UI.
const dashUrl = 'https://grafana.ops/d/api-errors';
const helpUrl = 'https://dtk.pipelab.dev/guides/reading-alerts/';

// detectkit logo as an inline SVG string (the <Logo> component can't be used
// inside a set:html string). `rx` is the avatar corner radius per platform.
const logoSvg = (size: number, rx: string) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 100 100" style="border-radius:${rx};flex:none">` +
  `<rect x="3" y="3" width="94" height="94" rx="26" fill="#D15B36"/>` +
  `<polyline points="14,62 36,62 50,22 64,62 86,62" fill="none" stroke="#FBF9F3" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>` +
  `<circle cx="50" cy="22" r="6.5" fill="#FBF9F3"/></svg>`;

// Per-state content. Fields are [label, value, short, mono].
// Links is one compact block of clickable labels — never raw URLs (a real
// dashboard URL can be paragraph-long), matching the webhook channel rendering.
const linkField: [string, string, boolean, boolean] = [
  'Links',
  `<a href="${dashUrl}">Dashboard</a> · <a href="${helpUrl}">How to read this alert</a>`,
  false,
  false,
];
const ALERT = {
  anomaly: {
    title: '🔴 [payments] Alert: api_error_rate',
    pill: 'ANOMALY',
    rule: 'min_detectors=1 · direction=same · consecutive=3',
    // The lead leads with "how long has this been going on" — the metric
    // interval, the streak length and the wall-clock duration — so a reader
    // knows immediately whether the corridor was breached just now or hours ago.
    lead: 'Anomalous for 1h — 6 consecutive 10min intervals.',
    fields: [
      ['Value', '4.2', true, true],
      ['Expected', '&lt;= 1.1', true, true],
      ['Quorum', '1/1 · above', true, false],
      ['Severity', '3.40', true, false],
      ['Started', '2026-06-19 11:14:00 (Europe/Moscow)', true, false],
      ['Latest', '2026-06-19 12:04:00 (Europe/Moscow)', true, false],
      ['Detectors', 'mad', false, true],
      ['Parameters', '{"threshold": 3.0, "window_size": 2016, "half_life": "1d"}', false, true],
      linkField,
    ] as [string, string, boolean, boolean][],
    emailStats: [
      ['Value', '4.2'],
      ['Expected', '&lt;= 1.1'],
      ['Severity', '3.40'],
      ['Quorum', '1/1 · above'],
      ['Started', '2026-06-19 11:14:00 (Europe/Moscow)'],
      ['Latest', '2026-06-19 12:04:00 (Europe/Moscow)'],
    ] as [string, string][],
    params: '{"threshold": 3.0, "window_size": 2016, "half_life": "1d"}',
  },
  recovery: {
    title: '🟢 [payments] Alert cleared: api_error_rate',
    pill: 'RECOVERED',
    rule: 'min_detectors=1 · direction=same · consecutive=3',
    lead: 'The alert condition no longer holds — the metric is back within expected bounds. Incident lasted 1h (6 consecutive 10min intervals).',
    fields: [
      ['Value', '1.0', true, true],
      ['Expected', '&lt;= 1.1', true, true],
      ['Started', '2026-06-19 11:36:00 (Europe/Moscow)', true, false],
      ['Cleared', '2026-06-19 12:36:00 (Europe/Moscow)', true, false],
      ['Detectors', 'mad', false, true],
      linkField,
    ] as [string, string, boolean, boolean][],
    emailStats: [
      ['Value', '1.0'],
      ['Expected', '&lt;= 1.1'],
      ['Started', '2026-06-19 11:36:00 (Europe/Moscow)'],
      ['Cleared', '2026-06-19 12:36:00 (Europe/Moscow)'],
      ['Detector', 'mad'],
    ] as [string, string][],
    params: '',
  },
};

// Description first, then the firing rule set apart as a bold "Rule" label + an
// inline-code chip sitting right above the value/expected fields it explains —
// the same description → Rule → evidence order on every channel (anomaly and
// recovery alike), mirroring the real channels.
const ruleLead = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  const chip = `<strong>Rule</strong> <code>${d.rule}</code>`;
  return `${d.lead}<br>${chip}`;
};

// Slack / Mattermost — one fields-based attachment (the metric name is the
// clickable attachment title; long values span full width; mentions ride in
// the top-level message text).
const fieldsHtml = (fields: [string, string, boolean, boolean][]) =>
  '<div class="att-fields">' +
  fields
    .map(([k, v, short, mono]) => {
      const val = k === 'Links' ? v : mono ? `<code>${v}</code>` : v;
      return `<div class="att-field ${short ? 'short' : 'full'}"><div class="fk">${k}</div><div class="fv">${val}</div></div>`;
    })
    .join('') +
  '</div>';

const attachmentHtml = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  return (
    '<div class="att-mentions"><span class="ment">@oncall_engineer</span> <span class="ment">@here</span></div>' +
    '<div class="attachment">' +
    '<div class="bar"></div>' +
    '<div class="content">' +
    `<a class="att-title" href="${dashUrl}">${d.title}<span class="ext"> ↗</span></a>` +
    `<div class="att-lead">${ruleLead(sev)}</div>` +
    fieldsHtml(d.fields) +
    `<div class="att-footer">${logoSvg(13, '3px')}<span>detectkit · payments</span></div>` +
    '</div></div>'
  );
};

const slackPanelHtml = (sev: 'anomaly' | 'recovery') =>
  '<div class="chat-msg">' +
  logoSvg(38, '9px') +
  '<div class="chat-body"><div class="chat-head">' +
  '<span class="chat-name">detectkit</span><span class="chat-tag">APP</span><span class="chat-time">12:04</span>' +
  '</div>' +
  attachmentHtml(sev) +
  '</div></div>';

const mmPanelHtml = (sev: 'anomaly' | 'recovery') =>
  '<div class="chat-msg">' +
  logoSvg(38, '50%') +
  '<div class="chat-body"><div class="chat-head">' +
  '<span class="chat-name">detectkit</span><span class="chat-tag bot">BOT</span><span class="chat-time">12:04</span>' +
  '</div>' +
  attachmentHtml(sev) +
  '</div></div>';

// Telegram — an escaped-HTML message: status dot, bold headline, rule, evidence
// in <code>, an inline "Open dashboard" link, then mentions.
const tgCheck =
  '<svg width="13" height="13" viewBox="0 0 24 24" fill="#3390EC"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>';
const tgTextHtml = (sev: 'anomaly' | 'recovery') => {
  const dot = sev === 'anomaly' ? '🔴' : '🟢';
  const word = sev === 'anomaly' ? 'Anomaly' : 'Recovered';
  const head =
    `${dot} <b>[payments] ${word} · api_error_rate</b>\n\n` +
    (sev === 'anomaly'
      ? 'Anomalous for 1h — 6 consecutive 10min intervals.\n'
      : 'The alert condition no longer holds — the metric is back within expected bounds. Incident lasted 1h (6 consecutive 10min intervals).\n') +
    '<b>Rule</b> <code>min_detectors=1 · direction=same · consecutive=3</code>\n\n';
  const evidence =
    sev === 'anomaly'
      ? '• Value: <code>4.2</code> · Expected: <code>&lt;= 1.1</code>\n' +
        '• Quorum: <code>1/1 · above</code>\n' +
        '• Severity: <code>3.40</code>\n' +
        '• Started: <code>2026-06-19 11:14:00 (Europe/Moscow)</code> · Latest: <code>2026-06-19 12:04:00 (Europe/Moscow)</code>\n' +
        '• Detector: <code>mad</code>\n' +
        '• Parameters: <code>{"threshold": 3.0, "window_size": 2016, "half_life": "1d"}</code>\n'
      : '• Value: <code>1.0</code> · Expected: <code>&lt;= 1.1</code>\n' +
        '• Started: <code>2026-06-19 11:36:00 (Europe/Moscow)</code> · Cleared: <code>2026-06-19 12:36:00 (Europe/Moscow)</code>\n' +
        '• Detector: <code>mad</code>\n';
  return (
    head +
    evidence +
    `\n<a href="${dashUrl}">Open dashboard</a> · <a href="${helpUrl}">How to read this alert</a>\n\n` +
    '<span class="ment">@oncall_engineer</span>'
  );
};

const tgPanelHtml = (sev: 'anomaly' | 'recovery') =>
  '<div class="tg-msg">' +
  logoSvg(34, '50%') +
  '<div class="tg-bubble">' +
  `<div class="tg-name">detectkit ${tgCheck}</div>` +
  `<div class="tg-text">${tgTextHtml(sev)}</div>` +
  '<div class="tg-meta">12:04</div>' +
  '</div></div>';

// Email — a branded HTML card inside a mail-client chrome.
const emailStatsHtml = (stats: [string, string][]) =>
  '<div class="ec-grid">' +
  stats
    .map(
      ([k, v]) =>
        `<div class="ec-cell"><div class="ec-k">${k}</div><div class="ec-v">${v}</div></div>`
    )
    .join('') +
  '</div>';

const emailCardHtml = (sev: 'anomaly' | 'recovery') => {
  const d = ALERT[sev];
  const paramsBlock = d.params
    ? `<div class="ec-plabel">Detector · mad</div><div class="ec-params">${d.params}</div>`
    : '';
  return (
    '<div class="email-card">' +
    '<div class="ec-accent"></div>' +
    '<div class="ec-head">' +
    logoSvg(26, '6px') +
    '<span class="ec-brand">detectkit</span>' +
    `<span class="ec-pill">${d.pill}</span>` +
    '</div>' +
    '<div class="ec-eyebrow">payments</div>' +
    '<div class="ec-title">api_error_rate</div>' +
    `<div class="ec-lead">${ruleLead(sev)}</div>` +
    emailStatsHtml(d.emailStats) +
    paramsBlock +
    `<a class="ec-btn" href="${dashUrl}">Open dashboard →</a>` +
    '<div class="ec-foot">Sent by detectkit · payments · CC: oncall_engineer · ' +
    `<a class="ec-foot-link" href="${helpUrl}">How to read this alert →</a></div>` +
    '</div>'
  );
};

const emailPanelHtml = (sev: 'anomaly' | 'recovery') =>
  '<div class="email-msg">' +
  '<div class="email-head">' +
  logoSvg(34, '50%') +
  '<div class="email-meta">' +
  '<div class="email-from"><b>detectkit alerts</b> <span>&lt;alerts@detectkit.dev&gt;</span></div>' +
  '<div class="email-sub">to team@example.com · 12:04</div>' +
  '</div>' +
  '<svg class="email-reply" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9C2B4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>' +
  '</div>' +
  emailCardHtml(sev) +
  '</div>';

// ---- Detectors explainer: four "corridors of normal", each shown on the
// metric shape it is built for (mad = noisy, zscore = clean bell, iqr = skewed,
// manual = hard-bounded). A rolling-median corridor is recomputed per series
// (or fixed for manual_bounds) on a 900×380 grid. The SVG holds only graphics;
// every text annotation (legend, axis, anomaly callout, max/min) is an HTML
// overlay so it stays legible when the chart scales down on mobile. Colors are
// .dx-* tokens in landing.css (no hardcoded hex). Geometry mirrors the brand guide.
const dxExplainer = (() => {
  const N = 46;
  const W = 900;
  const H = 380;
  const x0 = 70;
  const x1 = W - 74;
  const y1 = H - 56;
  const plotW = x1 - x0;
  const plotH = y1 - 66;
  const X = (i) => +(x0 + (i / (N - 1)) * plotW).toFixed(1);
  const Yv = (v) => +(y1 - v * plotH).toFixed(1);
  const pct = (v, span) => +((v / span) * 100).toFixed(2);
  const median = (a) => {
    const s = [...a].sort((p, q) => p - q);
    const m = s.length >> 1;
    return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
  };
  const clamp = (v) => Math.max(0.04, Math.min(0.98, v));
  const grid = [0.25, 0.5, 0.75]
    .map((v) => `<line class="dx-grid" x1="${x0}" y1="${Yv(v)}" x2="${x1}" y2="${Yv(v)}"/>`)
    .join('');

  // Each detector's series is the kind of metric it handles best.
  const SERIES = {
    // mad — messy, jittery signal with a sharp final spike (robust default)
    mad: [
      0.45, 0.4, 0.48, 0.42, 0.38, 0.46, 0.41, 0.49, 0.43, 0.39, 0.47, 0.42,
      0.5, 0.44, 0.4, 0.48, 0.43, 0.51, 0.45, 0.41, 0.49, 0.44, 0.42, 0.48,
      0.45, 0.4, 0.47, 0.5, 0.44, 0.42, 0.48, 0.54, 0.9, 0.58, 0.46, 0.42,
      0.49, 0.44, 0.4, 0.47, 0.42, 0.5, 0.45, 0.41, 0.48, 0.44,
    ],
    // iqr — skewed signal: low baseline with occasional upward tails
    iqr: [
      0.34, 0.31, 0.36, 0.33, 0.3, 0.35, 0.32, 0.5, 0.37, 0.33, 0.31, 0.36,
      0.34, 0.49, 0.33, 0.3, 0.35, 0.32, 0.38, 0.34, 0.31, 0.48, 0.35, 0.33,
      0.3, 0.36, 0.34, 0.32, 0.5, 0.33, 0.31, 0.36, 0.9, 0.42, 0.34, 0.31,
      0.35, 0.33, 0.3, 0.47, 0.34, 0.32, 0.36, 0.33, 0.31, 0.35,
    ],
    // manual_bounds — steady signal that briefly breaches a hard ceiling
    manual: [
      0.48, 0.45, 0.5, 0.47, 0.44, 0.49, 0.46, 0.51, 0.47, 0.45, 0.5, 0.46,
      0.52, 0.48, 0.45, 0.49, 0.47, 0.51, 0.48, 0.46, 0.5, 0.47, 0.45, 0.49,
      0.47, 0.44, 0.48, 0.51, 0.47, 0.45, 0.49, 0.56, 0.86, 0.59, 0.48, 0.45,
      0.5, 0.46, 0.44, 0.49, 0.46, 0.51, 0.47, 0.45, 0.49, 0.46,
    ],
  };
  // zscore — clean, smooth, bell-shaped signal with a single tail event
  const zscoreSeries = () => {
    const a = [];
    for (let i = 0; i < N; i++) {
      a.push(+(0.5 + 0.085 * Math.sin(i * 0.46) + 0.015 * Math.cos(i * 1.1)).toFixed(3));
    }
    a[32] = 0.9;
    return a;
  };

  const GLYPH = {
    mad:
      '<svg viewBox="0 0 40 40" class="dx-gl"><rect class="dx-gl-area" x="14" y="6" width="12" height="28" rx="3" fill-opacity="0.13"/><line class="dx-gl-stroke" x1="20" y1="6" x2="20" y2="34" stroke-width="2.4" stroke-linecap="round"/><line class="dx-gl-stroke" x1="14" y1="6" x2="26" y2="6" stroke-width="2.4" stroke-linecap="round"/><line class="dx-gl-stroke" x1="14" y1="34" x2="26" y2="34" stroke-width="2.4" stroke-linecap="round"/><circle class="dx-gl-solid" cx="20" cy="20" r="4"/></svg>',
    zscore:
      '<svg viewBox="0 0 44 34" class="dx-gl"><path class="dx-gl-area" d="M3 31 C16 31 16 6 22 6 C28 6 28 31 41 31" fill-opacity="0.12"/><path class="dx-gl-stroke" d="M3 31 C16 31 16 6 22 6 C28 6 28 31 41 31" fill="none" stroke-width="2.2" stroke-linecap="round"/><line class="dx-gl-stroke" x1="22" y1="6" x2="22" y2="31" stroke-width="1.4" stroke-dasharray="2 3"/><circle class="dx-gl-solid" cx="38" cy="29" r="2.6"/></svg>',
    iqr:
      '<svg viewBox="0 0 44 34" class="dx-gl"><line class="dx-gl-stroke" x1="4" y1="17" x2="13" y2="17" stroke-width="2" stroke-linecap="round"/><line class="dx-gl-stroke" x1="31" y1="17" x2="36" y2="17" stroke-width="2" stroke-linecap="round"/><rect class="dx-gl-box" x="13" y="8" width="18" height="18" rx="3" fill-opacity="0.13" stroke-width="2.2"/><line class="dx-gl-stroke" x1="22" y1="8" x2="22" y2="26" stroke-width="2.2"/><circle class="dx-gl-solid" cx="41" cy="17" r="2.8"/></svg>',
    manual:
      '<svg viewBox="0 0 40 40" class="dx-gl"><line class="dx-gl-stroke" x1="5" y1="11" x2="35" y2="11" stroke-width="2.4" stroke-dasharray="6 4" stroke-linecap="round"/><line class="dx-gl-stroke" x1="5" y1="29" x2="35" y2="29" stroke-width="2.4" stroke-dasharray="6 4" stroke-linecap="round"/><path class="dx-gl-solid" d="M20 18 l4 5 h-8 z"/><path class="dx-gl-solid" d="M20 22 l-4 -5 h8 z" opacity="0.4"/></svg>',
  };

  const META = {
    mad: {
      code: 'mad',
      name: 'Median absolute deviation',
      desc: 'Measures the typical distance from the median. A handful of wild spikes barely move it — the most robust default.',
      formula: 'median ± 3 × MAD',
      best: 'Spiky, noisy metrics with outliers in their history.',
      anom: '3.40 σ',
      cfg: { hUp: 0.135, hDn: 0.135 },
    },
    zscore: {
      code: 'zscore',
      name: 'Z-score',
      desc: 'Classic mean ± k standard deviations. Fast and simple, but one big outlier inflates the band — keep it for clean data.',
      formula: 'mean ± 3 × σ',
      best: 'Clean, roughly bell-shaped metrics.',
      anom: 'z = 4.1',
      cfg: { hUp: 0.13, hDn: 0.13 },
    },
    iqr: {
      code: 'iqr',
      name: 'Interquartile range',
      desc: 'Builds the corridor from the middle 50% of values, then extends fences 1.5×IQR out. Comfortable with skewed, long-tailed data.',
      formula: '[ Q1 − 1.5·IQR , Q3 + 1.5·IQR ]',
      best: 'Skewed distributions and one-sided outliers.',
      anom: 'beyond fence',
      cfg: { hUp: 0.21, hDn: 0.1 },
    },
    manual: {
      code: 'manual_bounds',
      name: 'Manual bounds',
      desc: 'No statistics at all — you set hard floor and ceiling values. Alerts the instant a metric crosses a known SLA line.',
      formula: 'value < min  or  value > max',
      best: 'Known SLAs and hard business limits.',
      anom: '> max',
      cfg: null,
    },
  };

  const build = (id) => {
    const m = META[id];
    const manual = id === 'manual';
    const values = id === 'zscore' ? zscoreSeries() : SERIES[id];
    const center = values.map((_, i) => median(values.slice(Math.max(0, i - 4), Math.min(N, i + 5))));
    let upper, lower;
    if (manual) {
      upper = values.map(() => 0.7);
      lower = values.map(() => 0.2);
    } else {
      upper = center.map((c) => clamp(c + m.cfg.hUp));
      lower = center.map((c) => clamp(c - m.cfg.hDn));
    }
    const lineP = 'M' + values.map((v, i) => X(i) + ',' + Yv(v)).join(' L');
    const bandP =
      'M' +
      upper.map((v, i) => X(i) + ',' + Yv(v)).join(' L') +
      ' L' +
      lower.map((v, i) => X(i) + ',' + Yv(v)).reverse().join(' L') +
      ' Z';
    const centerP = manual ? '' : 'M' + center.map((v, i) => X(i) + ',' + Yv(v)).join(' L');
    const ai = values.indexOf(Math.max(...values));
    const ax = X(ai);
    const ay = Yv(values[ai]);

    const svg =
      `<svg class="dx-svg" viewBox="0 0 ${W} ${H}" aria-hidden="true">` +
      grid +
      `<line class="dx-axisline" x1="${x0}" y1="${y1 + 1}" x2="${x1}" y2="${y1 + 1}" stroke-width="1.4"/>` +
      `<path class="dx-band" d="${bandP}" fill-opacity="0.12"/>` +
      (manual
        ? `<line class="dx-bound" x1="${x0}" y1="${Yv(0.7)}" x2="${x1}" y2="${Yv(0.7)}" stroke-width="2.2" stroke-dasharray="9 6"/>` +
          `<line class="dx-bound" x1="${x0}" y1="${Yv(0.2)}" x2="${x1}" y2="${Yv(0.2)}" stroke-width="2.2" stroke-dasharray="9 6"/>`
        : `<path class="dx-center" d="${centerP}" fill="none" stroke-width="1.4" stroke-dasharray="2 6" stroke-opacity="0.55"/>`) +
      `<path class="dx-line" d="${lineP}" fill="none" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" pathLength="1"/>` +
      `<circle class="dx-anom-halo" cx="${ax}" cy="${ay}" r="9"/>` +
      `<circle class="dx-anom" cx="${ax}" cy="${ay}" r="6" stroke-width="2.5"/>` +
      `</svg>`;

    const bounds = manual
      ? [
          { label: 'max', top: pct(Yv(0.7), H) },
          { label: 'min', top: pct(Yv(0.2), H) },
        ]
      : [];

    return {
      id,
      ...m,
      svg,
      glyph: GLYPH[id],
      bounds,
      calloutLeft: pct(ax, W),
      calloutTop: pct(ay, H),
    };
  };

  return { list: ['mad', 'zscore', 'iqr', 'manual'].map(build) };
})();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://dtk.pipelab.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://dtk.pipelab.dev/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="landing">
    <!-- ===== header ===== -->
    <header class="site-header">
      <nav class="wrap nav">
        <a class="brand" href="/">
          <Logo size={30} />
          <span>detectkit</span>
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
        <label for="nav-toggle" class="hamburger" aria-label="Toggle navigation">
          <span></span><span></span><span></span>
        </label>
        <div class="nav-panel">
          <div class="nav-links">
            <a href={docsHref}>Docs</a>
            <a href="/guides/detectors/">Detectors</a>
            <a href="/guides/alerting/">Alerting</a>
            <a href="/changelog/">Changelog</a>
          </div>
          <div class="nav-right">
            <a class="ghost-link" href={repo}>GitHub</a>
            <a class="pip" href={pypi}>pip install detectkit</a>
          </div>
        </div>
      </nav>
    </header>

    <!-- ===== hero ===== -->
    <section class="wrap hero">
      <div>
        <div class="badge"><span class="dot"></span>open source · python</div>
        <h1>Catch the spike<br />before it pages you.</h1>
        <p class="lede">
          Time-series anomaly detection and alerting with a dbt-like project layout. A metric is a
          SQL query plus a detector in YAML — run it with one command.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={startHref}>Get started</a>
          <a class="btn btn-ghost btn-code" href={pypi}>pip install detectkit</a>
        </div>
        <div class="hero-stats">
          {
            heroStats.map((s, i) => (
              <Fragment>
                {i > 0 && <span class="hs-dot" aria-hidden="true" />}
                {s.kind === 'stars' && (
                  <a class="hs-item hs-link" href={repo}>
                    <svg class="hs-star" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 .587l3.668 7.431 8.2 1.193-5.934 5.787 1.401 8.169L12 18.896l-7.335 3.871 1.401-8.169L.132 9.211l8.2-1.193z" />
                    </svg>
                    <strong>{s.label}</strong> {s.label === '1' ? 'star' : 'stars'}
                  </a>
                )}
                {s.kind === 'downloads' && (
                  <a class="hs-item hs-link" href={pypiStats}>
                    <strong>{s.label}</strong> downloads/mo
                  </a>
                )}
                {s.kind === 'license' && <span class="hs-item">MIT licensed</span>}
              </Fragment>
            ))
          }
        </div>
      </div>
      <div class="hero-viz">
        <div class="hero-chart">
          <div class="hero-chart-head">
            <span class="hc-name">api_error_rate</span>
            <span class="hc-meta">last 24h · 5min</span>
          </div>
          <svg class="hero-svg" viewBox="0 0 520 300" aria-hidden="true">
            <line class="hc-grid" x1="30" y1="90" x2="500" y2="90" />
            <line class="hc-grid" x1="30" y1="150" x2="500" y2="150" />
            <line class="hc-grid" x1="30" y1="210" x2="500" y2="210" />
            <path
              class="hc-band"
              d="M30,150 L80,148 L130,150 L180,147 L230,150 L280,148 L330,151 L380,149 L430,150 L500,149 L500,206 L430,205 L380,206 L330,204 L280,206 L230,205 L180,206 L130,204 L80,206 L30,205 Z"
            />
            <path class="hc-bound" d="M30,150 L500,149" />
            <path class="hc-bound" d="M30,205 L500,206" />
            <path
              class="hc-line"
              pathLength="1"
              d="M30,178 L60,182 L90,175 L120,184 L150,176 L180,186 L210,178 L240,182 L270,176 L300,184 L330,179 L360,188 L388,182 L405,178 L420,150 L435,96 L450,58 L466,120 L480,168 L500,178"
            />
            <!-- each marker is grouped so the looping replay can fade the whole
                 feature in/out (the <g>) while the halo pulses inside it -->
            <g class="hc-anom-g">
              <circle class="hc-halo" cx="450" cy="58" r="6" />
              <circle class="hc-anom" cx="450" cy="58" r="6" />
            </g>
            <!-- recovery: first point back inside the corridor (480,168) — fades
                 in once the line has drawn past it, then pulses green like the
                 anomaly, just before the green card -->
            <g class="hc-rec-g">
              <circle class="hc-rec-halo" cx="480" cy="168" r="6" />
              <circle class="hc-rec" cx="480" cy="168" r="5.5" />
            </g>
          </svg>
          <div class="hero-legend">
            <span><i class="dx-sw dx-sw-line"></i>metric</span>
            <span><i class="dx-sw dx-sw-band"></i>expected range</span>
            <span><i class="dx-sw dx-sw-anom"></i>anomaly</span>
            <span><i class="dx-sw dx-sw-rec"></i>recovery</span>
          </div>
        </div>
        <!-- two notifications, arriving like real Slack messages: the anomaly
             fires first, the recovery clears it a beat later. Both stay on
             screen so the looping hero tells the whole story at a glance. -->
        <div class="hero-alerts">
          <div class="hero-alert ha-anomaly">
            <Logo size={30} />
            <div class="ha-body">
              <div class="ha-title"><span class="ha-dot"></span>Anomaly · api_error_rate</div>
              <div class="ha-sub">value 4.2 · expected ≤ 1.1 → Slack</div>
            </div>
          </div>
          <div class="hero-alert ha-recovery">
            <Logo size={30} />
            <div class="ha-body">
              <div class="ha-title"><span class="ha-dot ha-dot-rec"></span>Recovered · api_error_rate</div>
              <div class="ha-sub">value 1.0 · back within range → Slack</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== works with (databases) ===== -->
    <section class="wrap">
      <div class="db-strip">
        <span class="db-strip-label">Works with</span>
        <DbBadges />
      </div>
    </section>

    <!-- ===== AI-native onboarding (lead with it — it's a core differentiator) ===== -->
    <section class="wrap section">
      <div class="eyebrow">dtk init-claude</div>
      <h2>AI-native: build metrics with an assistant, out of the box.</h2>
      <p class="sub">
        One command sets up <a href="https://claude.com/claude-code">Claude Code</a> for your
        project folder — a <code>CLAUDE.md</code>, a <code>.claude/rules/detectkit/</code> reference,
        and three skills: <code>dtk-setup-project</code> (configure your database),
        <code>dtk-new-metric</code> (scaffold a metric), and <code>dtk-feedback</code> (file a redacted
        bug report or feature request upstream). Now an assistant writes metrics, tunes detectors,
        wires up alerts, and reports issues with full knowledge of detectkit. Re-run it after an
        upgrade to refresh the context.
      </p>
      <div class="term">
        <div class="term-bar">
          <span class="b" style="background:#E5675B"></span>
          <span class="b" style="background:#E0A23B"></span>
          <span class="b" style="background:#2E9E73"></span>
          <span class="title">dtk init-claude</span>
        </div>
        <div class="body" set:html={claudeHtml}></div>
      </div>
    </section>

    <!-- ===== configuration: a SQL query → a caught anomaly ===== -->
    <section class="wrap section">
      <div class="eyebrow">configuration</div>
      <div class="cfg-head">
        <h2>From a SQL query to a caught anomaly.</h2>
        <p>
          A metric is just a query plus a detector in YAML. <code>dtk run</code> handles the
          corridor, the quorum and the alert — nothing else to wire up.
        </p>
      </div>

      <div class="cfg-term">
        <div class="cfg-bar">
          <span class="b" style="background:#E5675B"></span>
          <span class="b" style="background:#E0A23B"></span>
          <span class="b" style="background:#2E9E73"></span>
          <span class="cfg-file">metrics/api_errors.yml</span>
          <span class="cfg-lang">YAML</span>
        </div>

        <div class="cfg-grid">
          <div class="cfg-config code" set:html={yamlHtml}></div>

          <div class="cfg-output">
            <div class="cfg-cmd">
              <span class="cfg-prompt">$</span> dtk run --select <span class="cfg-arg">api_error_rate</span><span class="cfg-caret">▋</span>
            </div>
            <div class="cfg-result">
              <div><span class="cfg-load">LOAD</span>   12 points · resumed</div>
              <div><span class="cfg-detect">DETECT</span> 1 anomaly · detector mad</div>
              <div><span class="cfg-alert">ALERT</span>  ✓ sent to mattermost_ops</div>
            </div>
            <div class="cfg-card">
              <div class="cfg-card-head">
                <span class="cfg-metric">api_error_rate</span>
                <span class="cfg-anom"><span class="cfg-anom-dot"></span>anomaly</span>
              </div>
              <svg class="cfg-svg" viewBox="0 0 320 96" aria-hidden="true">
                <path class="cfg-band" d="M8,56 L312,55 L312,72 L8,73 Z" />
                <path class="cfg-bound" d="M8,56 L312,55" />
                <path class="cfg-bound" d="M8,73 L312,72" />
                <path
                  class="cfg-line"
                  d="M8,64 L40,66 L72,62 L104,67 L136,63 L168,68 L196,64 L220,62 L240,30 L256,12 L272,52 L296,64 L312,63"
                />
                <circle class="cfg-halo" cx="256" cy="12" r="9" />
                <circle class="cfg-anom-pt" cx="256" cy="12" r="5" />
              </svg>
              <div class="cfg-card-foot">
                value <span class="cfg-val">4.2</span> · expected ≤ 1.1 · severity 3.40
              </div>
            </div>
          </div>
        </div>

        <div class="cfg-status">
          <span class="cfg-ok">✓ pipeline completed</span>
          <span class="cfg-dim">1 metric · 1 detector · 0.4s</span>
          <span class="cfg-dim cfg-right">idempotent · resumable</span>
        </div>
      </div>

      <div class="cfg-chips">
        <span class="cfg-chip">SQL on your warehouse</span>
        <span class="cfg-chip">detector in YAML</span>
        <span class="cfg-chip">one command</span>
        <span class="cfg-chip">version-controlled</span>
      </div>
    </section>

    <!-- ===== run output ===== -->
    <section class="wrap section">
      <div class="eyebrow">dtk run</div>
      <h2>A load → detect → alert run, in one tree.</h2>
      <p class="sub">
        The real output of <code>dtk run</code> — a load → detect → alert tree with cyan step
        headers and colored status lines. Idempotent: it resumes from the last saved point.
      </p>
      <div class="steps">
        <div class="step">
          <div class="step-h"><span class="step-dot step-load"></span>LOAD</div>
          <p>Run the SQL on your warehouse, in batches, from the last checkpoint.</p>
        </div>
        <div class="step-arrow" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </div>
        <div class="step">
          <div class="step-h"><span class="step-dot step-detect"></span>DETECT</div>
          <p>Each detector scores points against its learned corridor of normal.</p>
        </div>
        <div class="step-arrow" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </div>
        <div class="step">
          <div class="step-h"><span class="step-dot step-alert"></span>ALERT</div>
          <p>Quorum met → post to chat with the rule up top, recovery on the way back.</p>
        </div>
      </div>
      <div class="term">
        <div class="term-bar">
          <span class="b" style="background:#E5675B"></span>
          <span class="b" style="background:#E0A23B"></span>
          <span class="b" style="background:#2E9E73"></span>
          <span class="title">dtk run --select api_error_rate</span>
        </div>
        <div class="body" set:html={logHtml}></div>
      </div>
    </section>

    <!-- ===== detectors ===== -->
    <section class="wrap section">
      <div class="eyebrow">detectors</div>
      <h2>Robust statistics, not magic.</h2>
      <p class="sub">
        Every detector learns a <strong>corridor of normal</strong> from recent history, then flags
        the moment a metric steps outside it. Switch the detector to see the kind of metric it's
        built for.
      </p>

      <!-- CSS-only detector switcher: hidden radios drive the tab + panel visibility -->
      <div class="dx-card">
        <input class="dx-radio" type="radio" name="dx-detector" id="dx-mad" checked />
        <input class="dx-radio" type="radio" name="dx-detector" id="dx-zscore" />
        <input class="dx-radio" type="radio" name="dx-detector" id="dx-iqr" />
        <input class="dx-radio" type="radio" name="dx-detector" id="dx-manual" />

        <div class="dx-stage">
          {
            dxExplainer.list.map((d) => (
              <div class={`dx-panel dx-panel-${d.id}`}>
                <div class="dx-chart">
                  <div class="dx-legend">
                    <span><i class="dx-sw dx-sw-line" />metric</span>
                    <span><i class="dx-sw dx-sw-band" />expected range</span>
                    <span><i class="dx-sw dx-sw-anom" />anomaly</span>
                  </div>
                  <div class="dx-plot">
                    <Fragment set:html={d.svg} />
                    <div
                      class="dx-callout"
                      style={`left:${d.calloutLeft}%;top:${d.calloutTop}%`}
                    >
                      <span class="dx-callout-kw">anomaly</span>
                      <span class="dx-callout-sep">·</span>
                      <span class="dx-callout-val">{d.anom}</span>
                    </div>
                    {d.bounds.map((b) => (
                      <span class="dx-bound-tag" style={`top:${b.top}%`}>
                        {b.label}
                      </span>
                    ))}
                  </div>
                  <div class="dx-axis-row">
                    <span>7 days ago</span>
                    <span>now</span>
                  </div>
                </div>

                <div class="dx-info">
                  <div class="dx-info-head">
                    <div class="dx-glyph-chip" set:html={d.glyph} />
                    <div>
                      <div class="dx-code">{d.code}</div>
                      <div class="dx-subname">{d.name}</div>
                    </div>
                  </div>
                  <p class="dx-desc">{d.desc}</p>
                  <div class="dx-meta">
                    <div>
                      <div class="dx-meta-h">Corridor</div>
                      <div class="dx-chip">{d.formula}</div>
                    </div>
                    <div>
                      <div class="dx-meta-h">Best for</div>
                      <div class="dx-best">{d.best}</div>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <div class="dx-tabs">
          <label for="dx-mad"><span class="dx-tab-dot" />mad</label>
          <label for="dx-zscore"><span class="dx-tab-dot" />zscore</label>
          <label for="dx-iqr"><span class="dx-tab-dot" />iqr</label>
          <label for="dx-manual"><span class="dx-tab-dot" />manual_bounds</label>
        </div>
      </div>

      <p class="dx-foot">
        // the corridor is recomputed per window with seasonality grouping &amp; recency weighting —
        newer points count more<br />
        // each detector is shown on the metric shape it handles best — robust, bell-shaped, skewed
        or hard-bounded
      </p>
    </section>

    <!-- ===== alerting ===== -->
    <section class="wrap section">
      <div class="eyebrow">alerting</div>
      <h2>Alerts that lead with the rule that fired.</h2>
      <p class="sub">
        Direction-aware multi-detector quorum, cooldown, recovery and no-data alerts — posted to
        chat with the alert and its rule up top, anomaly evidence below.
      </p>
      <div class="alert-wrap platform-demo">
        <input class="pf-radio" type="radio" name="platform" id="pf-slack" checked />
        <input class="pf-radio" type="radio" name="platform" id="pf-mattermost" />
        <input class="pf-radio" type="radio" name="platform" id="pf-telegram" />
        <input class="pf-radio" type="radio" name="platform" id="pf-email" />
        <input class="pf-radio" type="radio" name="severity" id="sev-anomaly" checked />
        <input class="pf-radio" type="radio" name="severity" id="sev-recovery" />
        <div class="pf-controls">
          <div class="pf-tabs">
            <label for="pf-slack"><ChannelIcon name="slack" />Slack</label>
            <label for="pf-mattermost"><ChannelIcon name="mattermost" />Mattermost</label>
            <label for="pf-telegram"><ChannelIcon name="telegram" />Telegram</label>
            <label for="pf-email"><ChannelIcon name="email" />Email</label>
          </div>
          <div class="pf-sev">
            <label for="sev-anomaly">Anomaly</label>
            <label for="sev-recovery">Recovery</label>
          </div>
        </div>
        <p class="pf-note">
          The same alert, posted by detectkit to each channel — rendered as that channel formats it: a
          fields attachment on Slack/Mattermost, escaped HTML on Telegram, a branded card in email.
          Each leads with the project name (<code>[payments]</code>) so several projects can share one
          channel while keeping the brand bot identity. The <code>dashboard_url</code> below becomes a
          first-class link on every channel.
        </p>
        <div class="pf-surface">
          <div class="pf-panels">
            <!-- Slack — fields-based webhook attachment, clickable title -->
            <div class="pf-panel pf-slack-panel">
              <div class="sev-anomaly-only" set:html={slackPanelHtml('anomaly')}></div>
              <div class="sev-recovery-only" set:html={slackPanelHtml('recovery')}></div>
            </div>
            <!-- Mattermost — same attachment, circle avatar + BOT tag -->
            <div class="pf-panel pf-mm-panel">
              <div class="sev-anomaly-only" set:html={mmPanelHtml('anomaly')}></div>
              <div class="sev-recovery-only" set:html={mmPanelHtml('recovery')}></div>
            </div>
            <!-- Telegram — escaped-HTML message, status dot, no color bar -->
            <div class="pf-panel pf-tg-panel">
              <div class="sev-anomaly-only" set:html={tgPanelHtml('anomaly')}></div>
              <div class="sev-recovery-only" set:html={tgPanelHtml('recovery')}></div>
            </div>
            <!-- Email — branded HTML card inside a mail client -->
            <div class="pf-panel pf-email-panel">
              <div class="sev-anomaly-only" set:html={emailPanelHtml('anomaly')}></div>
              <div class="sev-recovery-only" set:html={emailPanelHtml('recovery')}></div>
            </div>
          </div>
        </div>
        <pre class="pf-yaml"><span class="k">alerting</span>:
  <span class="k">channels</span>: [<span class="s">mattermost_ops</span>]
  <span class="k">dashboard_url</span>: <span class="s">{dashUrl}</span>   <span class="c"># one line → a link on every channel</span></pre>
      </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="wrap">
      <div class="cta-band">
        <div class="grid-bg"></div>
        <div class="inner">
          <h2>Ship your first detector in five minutes.</h2>
          <p>SQL + YAML, one command. No agents, no dashboards to babysit.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href={startHref}>Get started</a>
            <a class="pip" href={pypi}>pip install detectkit</a>
          </div>
        </div>
      </div>
    </section>

