---
import Logo from '../components/Logo.astro';
import '../styles/brand.css';
import '../styles/landing.css';

const repo = 'https://github.com/alexeiveselov92/detectkit';
const title = 'detectkit playground — the real tuning cockpit, on a metric you shape';
const description =
  "An interactive sandbox that IS detectkit's real `dtk tune` cockpit — the same chart, detectors, " +
  'modes and live catch-rate/false-alert metrics the tool ships — running on a synthetic metric you ' +
  'shape in the browser. Nothing is sent anywhere.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://dtk.pipelab.dev/playground/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://dtk.pipelab.dev/playground/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Theme: set before paint to avoid a flash. Auto / Light / Dark, matching the
         landing + docs — mode is stored, `data-theme` is the resolved look. Auto (the
         default) follows the OS preference and reacts live. -->
    <script is:inline>
      (function () {
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var mode;
        try {
          var saved = localStorage.getItem('dtk-theme');
          mode = saved === 'light' || saved === 'dark' || saved === 'auto' ? saved : 'auto';
        } catch (e) {
          mode = 'auto';
        }
        var root = document.documentElement;
        root.dataset.themeMode = mode;
        root.dataset.theme = mode === 'auto' ? (mq.matches ? 'dark' : 'light') : mode;
      })();
    </script>
  </head>
  <body class="landing pg-body">
    <!-- ===== slim brand header ===== -->
    <header class="site-header">
      <nav class="wrap nav">
        <a class="brand" href="/">
          <Logo size={30} />
          <span>detectkit</span>
        </a>
        <div class="nav-right pg-nav-right">
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Theme: Auto, Light or Dark"
            title="Theme: Auto → Light → Dark"
          >
            <svg class="ico-auto" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="12" rx="2" />
              <path d="M8 20h8M12 16v4" />
            </svg>
            <svg class="ico-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8" />
            </svg>
            <svg class="ico-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
          <a class="ghost-link pg-back" href="/">← home</a>
          <a class="ghost-link" href={repo}>GitHub</a>
          <a class="pip" href="/getting-started/installation/">Get started</a>
        </div>
      </nav>
    </header>

    <!-- ===== playground app: generator toolbar + the real cockpit ===== -->
    <main class="pg-app">
      <div class="pg-topbar">
        <!-- data generator (the one thing the real product doesn't have) — a compact
             single strip so the cockpit below still owns the full-height windshield. -->
        <div class="pg-gen" id="pg-gen">
          <span class="pg-lead">
            <span class="eyebrow">playground</span>
            the real <code>dtk&nbsp;tune</code> cockpit, on a metric you shape&nbsp;→
          </span>
          <span class="pg-field" title="The repeating shape of the metric. 'pulse' is a free-running ~7h cycle the calendar can't capture — the autoreg showcase.">
            <span class="pg-k">rhythm</span>
            <span class="pg-seg" data-control="rhythm">
              <button data-v="flat">flat</button>
              <button data-v="daily" class="on">daily</button>
              <button data-v="weekly">weekly</button>
              <button data-v="daily_weekly">daily+wk</button>
              <button data-v="business_hours">business</button>
              <button data-v="spiky_counts">spiky</button>
              <button data-v="pulse">pulse</button>
            </span>
          </span>

          <span class="pg-field" title="The problem to inject. 'pattern break' freezes the value mid-rhythm — normal in level, wrong in shape (the autoreg showcase).">
            <span class="pg-k">incident</span>
            <span class="pg-seg" data-control="incident">
              <button data-v="spike">spike</button>
              <button data-v="dip">dip</button>
              <button data-v="step">step</button>
              <button data-v="drift">drift</button>
              <button data-v="cluster" class="on">cluster</button>
              <button data-v="pattern_break">pattern break</button>
            </span>
          </span>

          <span class="pg-field" title="Grid step — the spacing between points.">
            <span class="pg-k">interval</span>
            <span class="pg-seg" data-control="interval">
              <button data-v="10min">10min</button>
              <button data-v="1h" class="on">1h</button>
              <button data-v="1d">1d</button>
            </span>
          </span>

          <span class="pg-field" title="Random jitter on top of the rhythm — higher noise widens the normal band.">
            <span class="pg-k">noise</span>
            <span class="pg-seg" data-control="noise">
              <button data-v="low">low</button>
              <button data-v="medium" class="on">medium</button>
              <button data-v="high">high</button>
            </span>
          </span>

          <span class="pg-field" title="A slow upward or downward drift over the whole series.">
            <span class="pg-k">trend</span>
            <span class="pg-seg" data-control="trend">
              <button data-v="none" class="on">none</button>
              <button data-v="up">up</button>
              <button data-v="down">down</button>
            </span>
          </span>

          <span class="pg-field" title="How large the injected incident is relative to normal.">
            <span class="pg-k">size <b id="pg-size-val">60%</b></span>
            <input id="pg-size" class="pg-range" type="range" min="0" max="100" step="1" value="60" />
          </span>

          <button id="pg-reseed" class="pg-btn" type="button" title="Draw a new random sample of the same shape.">↻ resample</button>
          <button
            id="pg-showcase"
            class="pg-btn pg-btn-accent"
            type="button"
            title="One click: switch to autoreg on a free-running pulse with a frozen-value pattern break — the anomaly windowed detectors miss and autoreg catches."
          >◹ shape-break showcase</button>
        </div>
      </div>

      <!-- the cockpit mounts here (report/tune.ts, fed the synthetic payload) -->
      <div id="dkx-mount" class="pg-mount"></div>
    </main>

    <!-- theme toggle (Auto → Light → Dark), mirrors the landing -->
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var root = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var order = ['auto', 'light', 'dark'];
        function apply(mode) {
          root.dataset.themeMode = mode;
          root.dataset.theme = mode === 'auto' ? (mq.matches ? 'dark' : 'light') : mode;
          try {
            localStorage.setItem('dtk-theme', mode);
          } catch (e) {}
        }
        btn.addEventListener('click', function () {
          var cur = root.dataset.themeMode || 'auto';
          apply(order[(order.indexOf(cur) + 1) % order.length]);
        });
        var onChange = function () {
          if ((root.dataset.themeMode || 'auto') === 'auto')
            root.dataset.theme = mq.matches ? 'dark' : 'light';
        };
        if (mq.addEventListener) mq.addEventListener('change', onChange);
        else if (mq.addListener) mq.addListener(onChange);
      })();
    </script>

    <script>
      import '../scripts/playground/main.ts';
    </script>

    <style is:global>
      /* Full-viewport app shell: slim header + generator toolbar + the cockpit
         filling the rest. Brand tokens flip with the theme via landing.css, so the
         toolbar + chart follow light/dark for free; the cockpit CHROME needs the
         retint below (it hardcodes light tokens in its injected stylesheet). */
      .pg-body {
        height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .pg-app {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
      }
      .pg-topbar {
        flex: 0 0 auto;
        padding: 7px 20px 9px;
        border-bottom: 1px solid var(--border);
        background: var(--paper);
      }
      .pg-gen {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 7px 14px;
      }
      .pg-lead {
        align-self: center;
        max-width: 220px;
        font-size: 12px;
        line-height: 1.3;
        color: var(--muted);
      }
      .pg-lead .eyebrow {
        display: block;
        margin-bottom: 1px;
      }
      .pg-lead code {
        font-family: var(--sl-font-mono, monospace);
        color: var(--clay);
        font-size: 11.5px;
      }
      .pg-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .pg-k {
        font-family: var(--sl-font-mono, monospace);
        font-size: 10.5px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--faint);
      }
      .pg-k b {
        color: var(--clay);
        font-weight: 700;
      }
      .pg-seg {
        display: flex;
        gap: 3px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 3px;
      }
      .pg-seg button {
        border: 0;
        background: transparent;
        color: var(--muted);
        font-family: inherit;
        font-size: 12px;
        padding: 4px 9px;
        border-radius: 6px;
        cursor: pointer;
        white-space: nowrap;
      }
      .pg-seg button:hover {
        color: var(--ink);
      }
      .pg-seg button.on {
        background: var(--clay);
        color: #fff;
        font-weight: 600;
      }
      .pg-range {
        width: 120px;
        accent-color: var(--clay);
        cursor: pointer;
      }
      .pg-btn {
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink);
        border-radius: 8px;
        padding: 7px 13px;
        font-family: inherit;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        align-self: flex-end;
      }
      .pg-btn:hover {
        border-color: var(--clay);
        color: var(--clay-700);
      }
      .pg-btn-accent {
        background: var(--clay);
        border-color: var(--clay);
        color: #fff;
      }
      .pg-btn-accent:hover {
        background: var(--clay-700);
        border-color: var(--clay-700);
        color: #fff;
      }
      .pg-mount {
        flex: 1 1 auto;
        min-height: 0;
      }
      /* Override the cockpit's 100dvh so it fills the app slot (not the viewport) and
         spans the full width like the toolbar above it. */
      .pg-mount .dtk-tune-root {
        height: 100%;
        max-width: none;
        padding-top: 6px;
      }
      /* Keep the cockpit a single-screen windshield. The generator strip above
         already names the metric shape, so the cockpit's own header ("your metric ·
         N points · … rhythm") is redundant here — hide it, and slim the brand bar,
         to give the chart back the vertical space it needs. */
      .pg-mount .dtk-tune-header {
        display: none;
      }
      .pg-body .nav {
        height: 52px;
      }

      /* Dark: the cockpit chrome hardcodes light tokens in its injected stylesheet
         (it ships light). Retint them so the rail/controls follow the page theme; the
         chart already follows :root (canvas token() reads :root, flipped by landing.css).
         Keep clay/green/anom, and fix the two boxes that use --ink as a DARK background. */
      :root[data-theme='dark'] .dtk-tune {
        --ink: #fbf9f3;
        --muted: #c9c2b4;
        --faint: #8a8373;
        --paper: #1b1916;
        --surface: #211e1a;
        --border: #332f29;
      }
      :root[data-theme='dark'] .dtk-tune-cfg,
      :root[data-theme='dark'] .dtk-tune-modes {
        background: #100f0d;
      }

      /* Narrow screens: let the page scroll and the cockpit stack (its own media
         query switches to height:auto — match it here so our override doesn't fight it). */
      @media (max-width: 900px) {
        .pg-body {
          height: auto;
          overflow: visible;
        }
        .pg-mount .dtk-tune-root {
          height: auto;
        }
      }
    </style>
  </body>
</html>
